{
  "name": "压缩图片",
  "description": "压缩图片（单张或目录批量）：调低质量、可等比缩小到指定最大宽度。适合给网页/上传优化图片体积。",
  "runtime": "python",
  "entry": "run.py",
  "allowNetwork": true,
  "timeoutMs": 90000,
  "params": [
    { "name": "path", "label": "图片路径或目录", "required": true },
    { "name": "quality", "label": "质量(1-100，默认 70)" },
    { "name": "max_width", "label": "最大宽度(可选，等比缩放)" },
    { "name": "output", "label": "输出目录(批量时可选)" }
  ]
}
